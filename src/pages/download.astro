---
import MarketingPage from "../layouts/MarketingPage.astro";
import { apps, server } from "../data/download";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const icons: Record<string, string> = {
  apple: '<rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />',
  android: '<rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M11 18.5h2" />',
  web: '<rect x="3" y="4.5" width="18" height="12" rx="1.8" /><path d="M1.5 19.5h21" />',
};
---

<MarketingPage title="Download" description="Get the Silo apps for Apple TV, iPhone, iPad, Android, and Android TV, and run Silo Server at home.">
  <section class="container page-head">
    <p class="eyebrow rise"><span>Download</span></p>
    <h1 class="page-title reveal-lines"><span class="ln"><span>Get Silo on</span></span><span class="ln"><span>every screen.</span></span></h1>
    <p class="lede rise"><span>Install the app wherever you watch. If someone invited you to their server, that's all you need.</span></p>
  </section>

  <section class="container dl-apps" id="apps" aria-label="Apps" data-reveal-group>
    {
      apps.map((app) => (
        <article class={`dl-app dl-app--${app.id}`}>
          <div class="dl-app__top">
            <span class="dl-app__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[app.id]} />
            </span>
            <span class="dl-app__status">{app.status}</span>
          </div>
          <p class="dl-app__devices">{app.devices}</p>
          <h2 class="dl-app__name">{app.name}</h2>
          <p class="dl-app__body">{app.body}</p>
          {app.links.length > 0 && (
            <div class="dl-app__links">
              {app.links.map((l) => (
                <a class:list={["btn", l.primary ? "btn--primary" : "btn--ghost"]} href={l.href} rel="noopener">
                  {l.label}
                  <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              ))}
            </div>
          )}
          {app.note && <p class="dl-app__note">{app.note}</p>}
        </article>
      ))
    }
  </section>

  <section class="dl-server section" aria-labelledby="server-title">
    <div class="container split">
      <div>
        <h2 id="server-title" class="h2 reveal-lines"><span class="ln"><span>Run your own</span></span><span class="ln"><span>server.</span></span></h2>
        <p class="lede rise"><span>{server.body}</span></p>
      </div>
      <div>
        <ul class="dl-needs" data-reveal-group>
          {server.needs.map((n) => <li>{n}</li>)}
        </ul>
        <p class="dl-footnote">{server.footnote}</p>
        <div class="dl-server__actions">
          <a class="btn btn--primary" href={`${baseUrl}${server.guide}`}>Read the install guide</a>
          <a class="link-arrow" href={server.source} rel="noopener">Source on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</MarketingPage>
