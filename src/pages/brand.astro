---
import Base from "../layouts/Base.astro";
import StatusBar from "../components/StatusBar.astro";
import Bottombar from "../components/Bottombar.astro";
import SiloBars from "../components/SiloBars.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const assetHref = (name: string) => `${baseUrl}/brand/${name}`;
const policyHref =
  "https://github.com/Silo-Server/siloserver.org/blob/main/TRADEMARK.md";
---

<Base
  title="brand assets"
  description="Official Silo logos, icons, colors, and practical guidance for using the Silo brand."
>
  <StatusBar />

  <main id="main" class="brand-page">
    <header class="brand-hero">
      <div class="brand-hero__copy">
        <p class="brand-kicker">
          <SiloBars size="sm" />
          brand manual / rev 01
        </p>
        <h1>Silo brand assets.</h1>
        <p class="brand-hero__lede">
          Official artwork for articles, integrations, presentations, and
          other places where you need to identify Silo clearly.
        </p>
        <p class="brand-hero__meta">
          4 asset types / 12 files <span>·</span> SVG masters + PNG renders
          <span>·</span> © 2026 Silo Media L.L.C.
        </p>
      </div>

      <div class="brand-hero__specimen" aria-label="Silo wordmark specimen">
        <img
          src={assetHref("silo-wordmark-white.svg")}
          alt="Silo"
          width="1389"
          height="720"
        />
        <span>primary horizontal lockup / full color + white</span>
      </div>
    </header>

    <section class="brand-section" aria-labelledby="downloads-title">
      <div class="brand-section__heading">
        <p>01 / assets</p>
        <div>
          <h2 id="downloads-title">Download the originals</h2>
          <p>
            Every SVG here is a master: no linked fonts, no embedded rasters,
            no external references. Prefer them wherever vectors are accepted
            and reach for a PNG only when they are not. Use the artwork as
            supplied—there is no need to redraw the mark or typeset the name.
          </p>
        </div>
      </div>

      <div class="asset-grid">
        <article class="asset-card asset-card--wide">
          <div class="asset-card__preview asset-card__preview--wordmark">
            <img
              src={assetHref("silo-wordmark-white.svg")}
              alt="Full-color Silo mark with a white Silo wordmark"
              width="1389"
              height="720"
            />
          </div>
          <div class="asset-card__body">
            <p class="asset-card__index">LOGO / 01</p>
            <h3>Horizontal wordmark</h3>
            <p>
              The preferred lockup for partner pages, articles, slides, and
              other horizontal placements. Choose dark lettering for light
              fields, white for deep blue and dark fields, or the mono cut
              when you have one ink to spend.
            </p>
            <dl>
              <div><dt>masters</dt><dd>3 transparent SVGs</dd></div>
              <div><dt>renders</dt><dd>2 PNGs · 1544 × 800 px</dd></div>
              <div><dt>mono</dt><dd>inherits currentColor</dd></div>
            </dl>
            <div class="asset-downloads">
              <a
                class="asset-download"
                href={assetHref("silo-wordmark-dark.svg")}
                download="silo-wordmark-dark.svg"
              >SVG / light fields <span>↓</span></a>
              <a
                class="asset-download"
                href={assetHref("silo-wordmark-white.svg")}
                download="silo-wordmark-white.svg"
              >SVG / dark fields <span>↓</span></a>
              <a
                class="asset-download"
                href={assetHref("silo-wordmark-mono.svg")}
                download="silo-wordmark-mono.svg"
              >SVG / one color <span>↓</span></a>
              <a
                class="asset-download asset-download--ghost"
                href={assetHref("silo-wordmark-dark.png")}
                download="silo-wordmark-dark.png"
              >PNG / light <span>↓</span></a>
              <a
                class="asset-download asset-download--ghost"
                href={assetHref("silo-wordmark-white.png")}
                download="silo-wordmark-white.png"
              >PNG / dark <span>↓</span></a>
            </div>
          </div>
        </article>

        <article class="asset-card">
          <div class="asset-card__preview asset-card__preview--mark">
            <img
              src={assetHref("silo-mark.svg")}
              alt="The Silo mark: a play triangle above three stacked bars"
              width="266"
              height="855"
            />
          </div>
          <div class="asset-card__body">
            <p class="asset-card__index">MARK / 02</p>
            <h3>The mark</h3>
            <p>
              The symbol on its own, for setting beside your own type. The
              dimensional cut is the default; use the flat cut below about
              48&nbsp;px and the mono cut for print, embroidery, and
              engraving.
            </p>
            <dl>
              <div><dt>masters</dt><dd>3 transparent SVGs</dd></div>
              <div><dt>ratio</dt><dd>266 × 855 units</dd></div>
              <div><dt>min size</dt><dd>24 px tall</dd></div>
            </dl>
            <div class="asset-downloads">
              <a
                class="asset-download"
                href={assetHref("silo-mark.svg")}
                download="silo-mark.svg"
              >SVG / dimensional <span>↓</span></a>
              <a
                class="asset-download"
                href={assetHref("silo-mark-flat.svg")}
                download="silo-mark-flat.svg"
              >SVG / flat <span>↓</span></a>
              <a
                class="asset-download"
                href={assetHref("silo-mark-mono.svg")}
                download="silo-mark-mono.svg"
              >SVG / one color <span>↓</span></a>
            </div>
          </div>
        </article>

        <article class="asset-card">
          <div class="asset-card__preview asset-card__preview--icon">
            <img
              src={assetHref("silo-project-icon.svg")}
              alt="Silo project icon"
              width="1024"
              height="1024"
            />
          </div>
          <div class="asset-card__body">
            <p class="asset-card__index">ICON / 03</p>
            <h3>Project icon</h3>
            <p>
              A compact square for avatars, favicons, directories, and
              integrations where the horizontal wordmark will not fit. The
              rounded corners are already cut, so the tile drops onto any
              background as-is.
            </p>
            <dl>
              <div><dt>master</dt><dd>SVG · corners cut</dd></div>
              <div><dt>render</dt><dd>PNG · 1024 × 1024 px</dd></div>
            </dl>
            <div class="asset-downloads">
              <a
                class="asset-download"
                href={assetHref("silo-project-icon.svg")}
                download="silo-project-icon.svg"
              >download SVG <span>↓</span></a>
              <a
                class="asset-download asset-download--ghost"
                href={assetHref("silo-project-icon.png")}
                download="silo-project-icon.png"
              >download PNG <span>↓</span></a>
            </div>
          </div>
        </article>

        <article class="asset-card">
          <div class="asset-card__preview asset-card__preview--icon">
            <img
              src={assetHref("silo-app-icon.svg")}
              alt="Silo app icon"
              width="1024"
              height="1024"
            />
          </div>
          <div class="asset-card__body">
            <p class="asset-card__index">APP / 04</p>
            <h3>App icon</h3>
            <p>
              The official product artwork, full bleed on the deep blue field
              so each store can cut its own corners. Provided for press and
              editorial coverage, not as an identity for third-party apps or
              forks.
            </p>
            <dl>
              <div><dt>master</dt><dd>SVG · full bleed</dd></div>
              <div><dt>render</dt><dd>PNG · 1024 × 1024 px</dd></div>
            </dl>
            <div class="asset-downloads">
              <a
                class="asset-download"
                href={assetHref("silo-app-icon.svg")}
                download="silo-app-icon.svg"
              >download SVG <span>↓</span></a>
              <a
                class="asset-download asset-download--ghost"
                href={assetHref("silo-app-icon.png")}
                download="silo-app-icon.png"
              >download PNG <span>↓</span></a>
            </div>
          </div>
        </article>
      </div>

      <p class="asset-notice">
        Downloads are Silo trademarks and remain © Silo Media L.L.C. See the
        <a href={assetHref("NOTICE.txt")}>asset notice</a> and guidance below.
      </p>
    </section>

    <section class="brand-section brand-section--rules" aria-labelledby="usage-title">
      <div class="brand-section__heading">
        <p>02 / usage</p>
        <div>
          <h2 id="usage-title">Keep it unmistakably Silo</h2>
          <p>
            Consistency matters more than decoration. Pick the asset that fits
            the space, keep the artwork intact, and make the relationship to
            Silo clear.
          </p>
        </div>
      </div>

      <div class="rules-grid">
        <article class="rules-card rules-card--do">
          <p class="rules-card__label">Do</p>
          <ul>
            <li>Use the supplied artwork without redrawing it.</li>
            <li>Leave comfortable clear space on every side.</li>
            <li>Use the wordmark variant with clear background contrast.</li>
            <li>Describe third-party work as “compatible with Silo.”</li>
            <li>Keep your own product name and identity more prominent.</li>
          </ul>
        </article>

        <article class="rules-card rules-card--dont">
          <p class="rules-card__label">Don’t</p>
          <ul>
            <li>Stretch, skew, rotate, crop, or rearrange the artwork.</li>
            <li>Recolor the mark or add shadows, outlines, or effects.</li>
            <li>Typeset “Silo” as a substitute for the supplied wordmark.</li>
            <li>Use the icon as the identity of a fork or third-party app.</li>
            <li>Imply sponsorship, endorsement, or official status.</li>
          </ul>
        </article>
      </div>

      <div class="context-table" role="region" aria-label="Asset selection guide" tabindex="0">
        <table>
          <thead>
            <tr><th>asset</th><th>best for</th><th>background</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>horizontal wordmark</td>
              <td>articles, decks, partner and compatibility pages</td>
              <td>dark art on light; white art on dark</td>
            </tr>
            <tr>
              <td>mark</td>
              <td>the symbol beside your own type</td>
              <td>transparent; flat cut below 48 px</td>
            </tr>
            <tr>
              <td>mono wordmark / mark</td>
              <td>one-color print, embroidery, engraving</td>
              <td>inherits currentColor</td>
            </tr>
            <tr>
              <td>project icon</td>
              <td>avatars, favicons, compact square placements</td>
              <td>use the complete supplied canvas</td>
            </tr>
            <tr>
              <td>app icon</td>
              <td>press coverage of official Silo applications</td>
              <td>use the complete supplied canvas</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="brand-section brand-section--build" aria-labelledby="construction-title">
      <div class="brand-section__heading">
        <p>03 / construction</p>
        <div>
          <h2 id="construction-title">Clear space and size</h2>
          <p>
            The mark is built on one rule: every slanted edge sits at exactly
            30° from horizontal. You never need to redraw it, but these are
            the measurements that keep a placement correct.
          </p>
        </div>
      </div>

      <div class="build-grid">
        <figure class="build-figure">
          <img
            src={assetHref("silo-construction.svg")}
            alt="Construction drawing of the Silo mark showing its clear space, 30° edges, and element measurements"
            width="712"
            height="800"
            loading="lazy"
          />
          <figcaption>construction drawing / units of the 1024 px icon</figcaption>
        </figure>

        <div class="build-notes">
          <div class="build-note">
            <p class="build-note__label">Clear space</p>
            <p>
              Keep at least the width of one bar counter—54 units, about 20%
              of the mark's width—free on all four sides. Nothing else sits
              inside it.
            </p>
          </div>
          <div class="build-note">
            <p class="build-note__label">Minimum size</p>
            <p>
              The mark reads cleanly down to about 24&nbsp;px tall. Below
              that use the flat cut, and below 16&nbsp;px use a single element
              rather than the full stack.
            </p>
          </div>
          <div class="build-note">
            <p class="build-note__label">Typography</p>
            <p>
              The wordmark is Plus Jakarta Sans ExtraBold at −0.04&nbsp;em
              tracking, converted to outlines. It is artwork, not live text—do
              not re-typeset it. The website's own faces are not part of the
              logo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="brand-section brand-section--palette" aria-labelledby="palette-title">
      <div class="brand-section__heading">
        <p>04 / palette</p>
        <div>
          <h2 id="palette-title">Logo palette</h2>
          <p>
            When the logo appears beside supporting graphics, these colors
            keep the surrounding material in the same visual family. Do not
            use them to recolor the supplied artwork.
          </p>
        </div>
      </div>

      <div class="swatches" aria-label="Silo logo colors">
        <div class="swatch" style="--swatch: #0034fb">
          <span></span><strong>signal blue</strong><code>#0034FB</code>
        </div>
        <div class="swatch" style="--swatch: #f50b4f">
          <span></span><strong>signal red</strong><code>#F50B4F</code>
        </div>
        <div class="swatch" style="--swatch: #fa7604">
          <span></span><strong>signal orange</strong><code>#FA7604</code>
        </div>
        <div class="swatch" style="--swatch: #010d9f">
          <span></span><strong>icon field</strong><code>#010D9F</code>
        </div>
        <div class="swatch" style="--swatch: #070b82">
          <span></span><strong>deep field</strong><code>#070B82</code>
        </div>
        <div class="swatch" style="--swatch: #181511">
          <span></span><strong>wordmark ink</strong><code>#181511</code>
        </div>
      </div>
    </section>

    <section class="permission" aria-labelledby="permission-title">
      <p class="permission__index">05 / permissions</p>
      <div>
        <h2 id="permission-title">Open source code. Protected identity.</h2>
        <p>
          You may use the Silo name and artwork to refer truthfully to Silo,
          redistribute official unmodified builds, and for editorial or
          educational coverage. Forks must rebrand. Silo-branded app-store
          releases, merchandise, commercial uses, and modified distributions
          require written permission.
        </p>
        <div class="permission__actions">
          <a href={policyHref}>read the full trademark policy ↗</a>
          <a href="mailto:trademark@siloserver.org">trademark@siloserver.org</a>
        </div>
      </div>
    </section>
  </main>

  <Bottombar />
</Base>

<style>
  .brand-page {
    max-width: var(--container-wide);
    margin: 0 auto;
    border-left: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 96%, transparent);
  }

  .brand-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.62fr);
    min-height: 420px;
    border-bottom: 1px solid var(--ink);
  }
  .brand-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
  }
  .brand-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    font: 500 0.72rem/1 var(--ff-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .brand-hero h1 {
    max-width: 620px;
    margin: 0;
    font: 800 clamp(3.2rem, 6vw, 5.4rem)/0.92 var(--ff-display);
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .brand-hero__lede {
    max-width: 630px;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .brand-hero__meta {
    margin: 1.75rem 0 0;
    font: 500 0.7rem/1.6 var(--ff-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .brand-hero__meta span {
    padding: 0 0.35rem;
    color: var(--orange);
  }
  .brand-hero__specimen {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
    overflow: hidden;
    background: linear-gradient(145deg, #0b169f, #070b82 68%, #060864);
    border-left: 1px solid var(--ink);
  }
  .brand-hero__specimen img {
    position: relative;
    z-index: 1;
    width: min(52%, 210px);
    height: auto;
  }
  .brand-hero__specimen span {
    position: absolute;
    right: 28px;
    bottom: 26px;
    left: 28px;
    z-index: 1;
    font: 500 0.62rem/1.4 var(--ff-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .brand-section {
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--rule);
  }
  .brand-section__heading {
    display: grid;
    grid-template-columns: minmax(120px, 0.25fr) minmax(0, 1fr);
    gap: 2rem;
    margin-bottom: 2.25rem;
  }
  .brand-section__heading > p,
  .permission__index {
    margin: 0.45rem 0 0;
    font: 500 0.68rem/1.4 var(--ff-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .brand-section__heading h2,
  .permission h2 {
    margin: 0;
    font: 800 clamp(2.1rem, 4vw, 3.4rem)/1 var(--ff-display);
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .brand-section__heading div > p {
    max-width: 720px;
    margin: 1.1rem 0 0;
    color: var(--ink-soft);
  }

  .asset-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--ink);
    background: var(--ink);
  }
  .asset-card {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--paper-high);
  }
  .asset-card--wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
  }
  .asset-card__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 230px;
    padding: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .asset-card__preview--wordmark {
    background: #070b82;
  }
  .asset-card__preview--wordmark img {
    width: min(68%, 220px);
    height: auto;
  }
  .asset-card__preview--icon {
    background: var(--paper-dim);
  }
  .asset-card__preview--icon img {
    width: min(62%, 170px);
    height: auto;
    box-shadow: 0 10px 24px rgba(11, 10, 8, 0.14);
  }
  .asset-card__preview--mark {
    background: var(--paper-dim);
  }
  .asset-card__preview--mark img {
    width: auto;
    height: min(46vw, 170px);
  }
  .asset-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .asset-card__index,
  .rules-card__label {
    margin: 0 0 1rem;
    font: 600 0.65rem/1 var(--ff-mono);
    letter-spacing: 0.16em;
    color: var(--blue);
  }
  .asset-card h3 {
    margin: 0;
    font: 800 clamp(1.7rem, 2.5vw, 2.35rem)/1 var(--ff-display);
    text-transform: uppercase;
    color: var(--ink);
  }
  .asset-card__body > p:not(.asset-card__index) {
    margin: 1rem 0 1.5rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .asset-card dl {
    width: 100%;
    margin: auto 0 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .asset-card dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    font: 500 0.67rem/1.4 var(--ff-mono);
  }
  .asset-card dt {
    color: var(--ink-mute);
    text-transform: uppercase;
  }
  .asset-card dd {
    margin: 0;
    color: var(--ink);
  }
  .asset-download {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 180px;
    padding: 0.8rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper-high);
    font: 600 0.68rem/1 var(--ff-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.14s ease, border-color 0.14s ease;
  }
  .asset-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }
  .asset-downloads .asset-download {
    flex: 1 1 145px;
    min-width: 0;
  }
  .asset-download:hover {
    border-color: var(--blue);
    background: var(--blue);
  }
  .asset-download--ghost {
    background: transparent;
    color: var(--ink);
  }
  .asset-download--ghost:hover {
    color: var(--paper-high);
  }
  .asset-download span {
    font-size: 1rem;
  }
  .asset-notice {
    margin: 1rem 0 0;
    font: 500 0.68rem/1.6 var(--ff-mono);
    color: var(--ink-mute);
  }
  .asset-notice a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .brand-section--rules {
    background: var(--paper-dim);
  }
  .rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border: 1px solid var(--ink);
    background: var(--ink);
  }
  .rules-card {
    padding: clamp(1.75rem, 4vw, 3.25rem);
    background: var(--paper-high);
  }
  .rules-card--do {
    border-top: 5px solid var(--blue);
  }
  .rules-card--dont {
    border-top: 5px solid var(--red);
  }
  .rules-card--dont .rules-card__label {
    color: var(--red);
  }
  .rules-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rules-card li {
    position: relative;
    padding: 0.85rem 0 0.85rem 1.75rem;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--ink-soft);
  }
  .rules-card li:last-child {
    border-bottom: 0;
  }
  .rules-card li::before {
    content: "+";
    position: absolute;
    left: 0;
    color: var(--blue);
    font: 600 1rem/1.6 var(--ff-mono);
  }
  .rules-card--dont li::before {
