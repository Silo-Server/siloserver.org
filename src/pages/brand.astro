---
import MarketingPage from "../layouts/MarketingPage.astro";
import { SITE } from "../data/siteConfig";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const assetHref = (name: string) => `${baseUrl}/brand/${name}`;
const policyHref =
  "https://github.com/Silo-Server/siloserver.org/blob/main/TRADEMARK.md";
const down =
  '<path d="M8 3v8M4.5 7.5 8 11l3.5-3.5M3.5 13.5h9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />';
const out =
  '<path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />';
---

<MarketingPage
  title="Brand assets"
  description="Official Silo logos, icons, colors, and practical guidance for using the Silo brand."
>
  <div class="brand-page">
    <header class="container page-head brand-hero">
      <div class="brand-hero__copy">
        <p class="eyebrow brand-kicker rise">
          <span><i class="bars" aria-hidden="true"><b></b><b></b><b></b></i>Brand manual · Rev 01</span>
        </p>
        <h1 class="page-title reveal-lines">
          <span class="ln"><span>Silo brand</span></span><span class="ln"><span>assets.</span></span>
        </h1>
        <p class="lede rise">
          <span>
            Official artwork for articles, integrations, presentations, and
            other places where you need to identify Silo clearly.
          </span>
        </p>
        <div class="brand-hero__meta rise">
          <ul aria-label="About these assets">
            <li>5 asset types / 18 files</li>
            <li>SVG masters + PNG renders + motion</li>
            <li>© 2026 Silo Media L.L.C.</li>
          </ul>
        </div>
        <div class="brand-hero__actions rise">
          <span>
            <a class="btn btn--primary" href="#assets">
              Download the originals
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
            </a>
            <a class="link-arrow" href="#usage">Usage guidelines</a>
          </span>
        </div>
      </div>

      <figure class="brand-hero__specimen rise" aria-label="Silo wordmark specimen">
        <span class="brand-hero__plate">
          <img
            src={assetHref("silo-wordmark-white.svg")}
            alt="Silo"
            width="1389"
            height="720"
          />
          <figcaption>Primary horizontal lockup / full color + white</figcaption>
        </span>
      </figure>
    </header>

    <section class="brand-section" id="assets" aria-labelledby="downloads-title">
      <div class="container">
        <div class="brand-head">
          <div>
            <p class="eyebrow">01 · Assets</p>
            <h2 id="downloads-title" class="brand-h2 reveal-lines">
              <span class="ln"><span>Download the</span></span><span class="ln"><span>originals</span></span>
            </h2>
          </div>
          <p class="brand-head__body rise">
            <span>
              Every SVG here is a master: no linked fonts, no embedded rasters,
              no external references. Prefer them wherever vectors are accepted
              and reach for a PNG only when they are not. Use the artwork as
              supplied—there is no need to redraw the mark or typeset the name.
            </span>
          </p>
        </div>

        <div class="asset-grid" data-reveal-group>
          <article class="card asset-card asset-card--wide">
            <div class="asset-card__preview asset-card__preview--pair">
              <div class="tile tile--light">
                <img
                  src={assetHref("silo-wordmark-dark.svg")}
                  alt="Full-color Silo mark with a dark Silo wordmark"
                  width="1389"
                  height="720"
                />
              </div>
              <div class="tile tile--field">
                <img
                  src={assetHref("silo-wordmark-white.svg")}
                  alt="Full-color Silo mark with a white Silo wordmark"
                  width="1389"
                  height="720"
                />
              </div>
            </div>
            <div class="card__body">
              <p class="card__index">Logo · 01</p>
              <h3>Horizontal wordmark</h3>
              <p class="card__text">
                The preferred lockup for partner pages, articles, slides, and
                other horizontal placements. Choose dark lettering for light
                fields, white for deep blue and dark fields, or the mono cut
                when you have one ink to spend.
              </p>
              <dl class="specs">
                <div><dt>Masters</dt><dd>3 transparent SVGs</dd></div>
                <div><dt>Renders</dt><dd>2 PNGs · 1544 × 800 px</dd></div>
                <div><dt>Mono</dt><dd>inherits currentColor</dd></div>
              </dl>
              <div class="downloads">
                <a class="btn btn--ghost dl" href={assetHref("silo-wordmark-dark.svg")} download="silo-wordmark-dark.svg">
                  SVG · light fields<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl" href={assetHref("silo-wordmark-white.svg")} download="silo-wordmark-white.svg">
                  SVG · dark fields<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl" href={assetHref("silo-wordmark-mono.svg")} download="silo-wordmark-mono.svg">
                  SVG · one color<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl dl--quiet" href={assetHref("silo-wordmark-dark.png")} download="silo-wordmark-dark.png">
                  PNG · light<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl dl--quiet" href={assetHref("silo-wordmark-white.png")} download="silo-wordmark-white.png">
                  PNG · dark<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
              </div>
            </div>
          </article>

          <article class="card asset-card">
            <div class="asset-card__preview">
              <div class="tile tile--light tile--mark">
                <img
                  src={assetHref("silo-mark.svg")}
                  alt="The Silo mark: a play triangle above three stacked bars"
                  width="266"
                  height="855"
                />
              </div>
            </div>
            <div class="card__body">
              <p class="card__index">Mark · 02</p>
              <h3>The mark</h3>
              <p class="card__text">
                The symbol on its own, for setting beside your own type. The
                dimensional cut is the default; use the flat cut below about
                48&nbsp;px and the mono cut for print, embroidery, and
                engraving.
              </p>
              <dl class="specs">
                <div><dt>Masters</dt><dd>3 transparent SVGs</dd></div>
                <div><dt>Ratio</dt><dd>266 × 855 units</dd></div>
                <div><dt>Min size</dt><dd>24 px tall</dd></div>
              </dl>
              <div class="downloads">
                <a class="btn btn--ghost dl" href={assetHref("silo-mark.svg")} download="silo-mark.svg">
                  SVG · dimensional<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl" href={assetHref("silo-mark-flat.svg")} download="silo-mark-flat.svg">
                  SVG · flat<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl" href={assetHref("silo-mark-mono.svg")} download="silo-mark-mono.svg">
                  SVG · one color<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
              </div>
            </div>
          </article>

          <article class="card asset-card">
            <div class="asset-card__preview">
              <div class="tile tile--dark tile--icon">
                <img
                  src={assetHref("silo-project-icon.svg")}
                  alt="Silo project icon"
                  width="1024"
                  height="1024"
                />
              </div>
            </div>
            <div class="card__body">
              <p class="card__index">Icon · 03</p>
              <h3>Project icon</h3>
              <p class="card__text">
                A compact square for avatars, favicons, directories, and
                integrations where the horizontal wordmark will not fit. The
                rounded corners are already cut, so the tile drops onto any
                background as-is.
              </p>
              <dl class="specs">
                <div><dt>Master</dt><dd>SVG · corners cut</dd></div>
                <div><dt>Render</dt><dd>PNG · 1024 × 1024 px</dd></div>
              </dl>
              <div class="downloads">
                <a class="btn btn--ghost dl" href={assetHref("silo-project-icon.svg")} download="silo-project-icon.svg">
                  Download SVG<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl dl--quiet" href={assetHref("silo-project-icon.png")} download="silo-project-icon.png">
                  Download PNG<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
              </div>
            </div>
          </article>

          <article class="card asset-card">
            <div class="asset-card__preview">
              <div class="tile tile--dark tile--icon">
                <img
                  src={assetHref("silo-app-icon.svg")}
                  alt="Silo app icon"
                  width="1024"
                  height="1024"
                />
              </div>
            </div>
            <div class="card__body">
              <p class="card__index">App · 04</p>
              <h3>App icon</h3>
              <p class="card__text">
                The official product artwork, full bleed on the deep blue field
                so each store can cut its own corners. Provided for press and
                editorial coverage, not as an identity for third-party apps or
                forks.
              </p>
              <dl class="specs">
                <div><dt>Master</dt><dd>SVG · full bleed</dd></div>
                <div><dt>Render</dt><dd>PNG · 1024 × 1024 px</dd></div>
              </dl>
              <div class="downloads">
                <a class="btn btn--ghost dl" href={assetHref("silo-app-icon.svg")} download="silo-app-icon.svg">
                  Download SVG<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
                <a class="btn btn--ghost dl dl--quiet" href={assetHref("silo-app-icon.png")} download="silo-app-icon.png">
                  Download PNG<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={down} />
                </a>
              </div>
            </div>
          </article>
        </div>

        <p class="notice">
          Downloads are Silo trademarks and remain © Silo Media L.L.C. See the
          <a href={assetHref("NOTICE.txt")}>asset notice</a> and guidance below.
        </p>
      </div>
    </section>

    <section class="brand-section brand-section--usage" id="usage" aria-labelledby="usage-title">
      <div class="container">
        <div class="brand-head">
          <div>
            <p class="eyebrow">02 · Usage</p>
            <h2 id="usage-title" class="brand-h2 reveal-lines">
              <span class="ln"><span>Most uses need</span></span><span class="ln"><span>no permission</span></span>
            </h2>
          </div>
          <p class="brand-head__body rise">
            <span>
              If you are writing about Silo, building something that works with
              it, or running it yourself, use the name and artwork freely. The
              only thing we ask is that your own project keeps its own identity,
              so nobody mistakes it for an official Silo release.
            </span>
          </p>
        </div>

        <div class="rules-grid" data-reveal-group>
          <article class="card rules-card rules-card--do">
            <p class="rules-card__label">Go ahead</p>
            <ul>
              <li>Describe your work as “compatible with Silo,” “a Silo client,” “a plugin for Silo,” or “based on Silo.”</li>
              <li>Use the Silo logo or icon in a project that works with Silo, such as to list Silo as a server type or on a “Connect to Silo” button. You may bundle the unmodified files in your source code and builds. Don’t alter them or make them your own project’s logo or app icon.</li>
              <li>Write articles, tutorials, reviews, and talks about Silo, with the artwork.</li>
              <li>Redistribute official, unmodified builds under the Silo name.</li>
              <li>Run, modify, and self-host Silo for yourself or your organization.</li>
            </ul>
          </article>

          <article class="card rules-card rules-card--dont">
            <p class="rules-card__label">Ask us first</p>
            <ul>
              <li>Shipping a modified build under the Silo name or logo.</li>
              <li>Publishing an app to any app store as Silo, or with a look-alike identity.</li>
              <li>Putting Silo in your company, product, domain, or app name in a way that reads as official. Wordplay is exempt; see naming below.</li>
              <li>Merchandise, or using the logo or wordmark to sell your own product beyond a “works with Silo” placement.</li>
              <li>Anything that suggests we run, sponsor, or endorse your offering.</li>
            </ul>
          </article>
        </div>

        <p class="rules-intro rules-intro--after">
          We say yes to most reasonable requests. The policy exists to prevent
          confusion, not to stop people building on Silo. Never use the name or
          logo to promote piracy or to impersonate the project.
        </p>

        <h3 class="rules-subhead" id="naming-title">Naming your project</h3>
        <p class="rules-intro">
          Pick a name that is yours, then mention Silo in the tagline. That is
          how the official products are told apart: the server is
          <strong>Silo Server</strong>, and official apps join “Silo” to a
          product word with no space, such as SiloRemote and SiloMac. So that
          pattern, and “Silo” on its own, are reserved. The test is simple: would
          a reasonable user think the Silo team made it?
        </p>

        <div class="rules-grid" data-reveal-group>
          <article class="card rules-card rules-card--do">
            <p class="rules-card__label">Works well</p>
            <ul>
              <li>“Bramble — a Silo client for Android TV”</li>
              <li>“Lantern, a lightweight Silo web player”</li>
              <li>“Trakt sync plugin for Silo”</li>
              <li>Repository and package names such as <code>silo-plugin-trakt</code>, where “silo” only describes what it plugs into.</li>
              <li>Wordplay such as “Siloette” or “Silodeon,” which reads as its own word rather than an official product. This is the exception to the reserved patterns, wherever you publish, as long as you use your own logo.</li>
            </ul>
          </article>

          <article class="card rules-card rules-card--dont">
            <p class="rules-card__label">Please avoid</p>
            <ul>
              <li>“Silo” alone, or as the first word of a product name, including “Silo Client” or “Silo Player” as the name itself.</li>
              <li>“Silo[word]” names such as SiloTV, SiloPlay, or SiloFlix, which read as official apps.</li>
              <li>“[word]Silo” names such as OpenSilo or MySilo, which read as the project itself.</li>
              <li>Misspellings and look-alikes such as Sylo or Si1o.</li>
            </ul>
          </article>
        </div>

        <h3 class="rules-subhead" id="writing-title">Writing the name</h3>
        <div class="card table-card" role="region" aria-label="How to write the Silo name" tabindex="0">
          <table>
            <thead>
              <tr><th>Context</th><th>Write it as</th><th>Example</th></tr>
            </thead>
            <tbody>
              <tr>
                <td data-label="Context">Prose and UI text</td>
                <td data-label="Write it as">Silo, capital S, one word</td>
                <td data-label="Example">“Connect to your Silo server.”</td>
              </tr>
              <tr>
                <td data-label="Context">The server product</td>
                <td data-label="Write it as">Silo Server, two words</td>
                <td data-label="Example">“Requires Silo Server 1.0 or later.”</td>
              </tr>
              <tr>
                <td data-label="Context">Repositories, packages, command-line binaries</td>
                <td data-label="Write it as">Lowercase silo</td>
                <td data-label="Example"><code>silo-server</code>, <code>silo-plugin-trakt</code></td>
              </tr>
              <tr>
                <td data-label="Context">App bundles and product names</td>
                <td data-label="Write it as">Display form</td>
                <td data-label="Example"><code>Silo</code>, <code>SiloTV</code></td>
              </tr>
              <tr>
                <td data-label="Context">Paths and config directories</td>
                <td data-label="Write it as">Follow the platform convention</td>
                <td data-label="Example"><code>/var/lib/silo</code>, <code>~/Library/Application Support/Silo</code></td>
              </tr>
              <tr class="is-never">
                <td data-label="Context">Never</td>
                <td data-label="Write it as">SILO, SiLo, Si-lo, or a typeset “Silo” in place of the wordmark</td>
                <td data-label="Example">—</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="rules-subhead" id="artwork-title">Handling the artwork</h3>
        <div class="rules-grid" data-reveal-group>
          <article class="card rules-card rules-card--do">
            <p class="rules-card__label">Do</p>
            <ul>
              <li>Use the supplied artwork without redrawing it.</li>
              <li>Leave comfortable clear space on every side.</li>
              <li>Use the wordmark variant with clear background contrast.</li>
              <li>Keep your own product name and identity more prominent.</li>
            </ul>
          </article>

          <article class="card rules-card rules-card--dont">
            <p class="rules-card__label">Don’t</p>
            <ul>
              <li>Stretch, skew, rotate, crop, or rearrange the artwork.</li>
              <li>Recolor the mark or add shadows, outlines, or effects.</li>
              <li>Build the mark into your own logo.</li>
              <li>Use the icon as the identity of a fork or third-party app.</li>
            </ul>
          </article>
        </div>

        <div class="card table-card table-card--after" role="region" aria-label="Asset selection guide" tabindex="0">
          <table>
            <thead>
              <tr><th>Asset</th><th>Best for</th><th>Background</th></tr>
            </thead>
            <tbody>
              <tr>
                <td data-label="Asset">Horizontal wordmark</td>
                <td data-label="Best for">Articles, decks, partner and compatibility pages</td>
                <td data-label="Background">Dark art on light; white art on dark</td>
              </tr>
              <tr>
                <td data-label="Asset">Mark</td>
                <td data-label="Best for">The symbol beside your own type</td>
                <td data-label="Background">Transparent; flat cut below 48 px</td>
              </tr>
              <tr>
                <td data-label="Asset">Mono wordmark / mark</td>
                <td data-label="Best for">One-color print, embroidery, engraving</td>
                <td data-label="Background">Inherits currentColor</td>
              </tr>
              <tr>
                <td data-label="Asset">Project icon</td>
                <td data-label="Best for">Avatars, favicons, compact square placements</td>
                <td data-label="Background">Use the complete supplied canvas</td>
              </tr>
              <tr>
                <td data-label="Asset">App icon</td>
                <td data-label="Best for">Press coverage of official Silo applications</td>
                <td data-label="Background">Use the complete supplied canvas</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="brand-section" id="construction" aria-labelledby="construction-title">
      <div class="container">
        <div class="brand-head">
          <div>
            <p class="eyebrow">03 · Construction</p>
            <h2 id="construction-title" class="brand-h2 reveal-lines">
              <span class="ln"><span>Clear space</span></span><span class="ln"><span>and size</span></span>
            </h2>
          </div>
          <p class="brand-head__body rise">
            <span>
              The mark is built on one rule: every slanted edge sits at exactly
              30° from horizontal. You never need to redraw it, but these are
              the measurements that keep a placement correct.
            </span>
          </p>
        </div>

        <div class="build-grid">
          <figure class="card build-figure">
            <img
              src={assetHref("silo-construction.svg")}
              alt="Construction drawing of the Silo mark showing its clear space, 30° edges, and element measurements"
              width="712"
              height="800"
              loading="lazy"
            />
            <figcaption>Construction drawing / units of the 1024 px icon</figcaption>
          </figure>

          <div class="build-notes" data-reveal-group>
            <div class="card build-note">
              <p class="build-note__label">Clear space</p>
              <p>
                Keep at least the width of one bar counter—54 units, about 20%
                of the mark's width—free on all four sides. Nothing else sits
                inside it.
              </p>
            </div>
            <div class="card build-note">
              <p class="build-note__label">Minimum size</p>
              <p>
                The mark reads cleanly down to about 24&nbsp;px tall. Below
                that use the flat cut, and below 16&nbsp;px use a single element
                rather than the full stack.
              </p>
            </div>
            <div class="card build-note">
              <p class="build-note__label">Typography</p>
              <p>
                The wordmark is Plus Jakarta Sans ExtraBold at −0.04&nbsp;em
                tracking, converted to outlines. It is artwork, not live text—do
                not re-typeset it. The website's own faces are not part of the
                logo.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="brand-section" id="palette" aria-labelledby="palette-title">
      <div class="container">
        <div class="brand-head">
          <div>
            <p class="eyebrow">04 · Palette</p>
            <h2 id="palette-title" class="brand-h2 reveal-lines">
              <span class="ln"><span>Logo palette</span></span>
            </h2>
          </div>
          <p class="brand-head__body rise">
            <span>
              When the logo appears beside supporting graphics, these colors
              keep the surrounding material in the same visual family. Do not
              use them to recolor the supplied artwork. You are welcome to use
              the colors, and the three-bar motif from the website, in your own
              client or plugin interface. The logo, wordmark, and icons are what we
              reserve, so keep your own logo a different shape.
            </span>
          </p>
        </div>

        <div class="swatches" aria-label="Silo logo colors">
          <div class="card swatch" style="--swatch: #0034fb">
            <span></span><strong>Signal blue</strong><code>#0034FB</code>
          </div>
          <div class="card swatch" style="--swatch: #f50b4f">
            <span></span><strong>Signal red</strong><code>#F50B4F</code>
          </div>
          <div class="card swatch" style="--swatch: #fa7604">
            <span></span><strong>Signal orange</strong><code>#FA7604</code>
          </div>
          <div class="card swatch" style="--swatch: #010d9f">
            <span></span><strong>Icon field</strong><code>#010D9F</code>
          </div>
          <div class="card swatch" style="--swatch: #070b82">
            <span></span><strong>Deep field</strong><code>#070B82</code>
          </div>
          <div class="card swatch" style="--swatch: #181511">
            <span></span><strong>Wordmark ink</strong><code>#181511</code>
          </div>
        </div>
      </div>
    </section>

    <section class="brand-section" id="motion" aria-labelledby="motion-title">
      <div class="container">
        <div class="brand-head">
          <div>
            <p class="eyebrow">05 · Motion</p>
            <h2 id="motion-title" class="brand-h2 reveal-lines">
              <span class="ln"><span>The logo</span></span><span class="ln"><span>in motion</span></span>
            </h2>
          </div>
          <p class="brand-head__body rise">
            <span>
              The animation our apps play on launch, built from the same vector
              masters. The mark assembles a bar at a time, then slides aside to
              let the wordmark out from behind it.
            </span>
          </p>
        </div>

        <div class="motion-grid">
          <article class="card motion-card motion-card--wide">
            <div class="motion-card__stage motion-card__stage--video">
              <video
                src={assetHref("silo-motion-splash.mp4")}
                width="1920"
                height="1080"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                aria-label="The Silo logo assembling, then revealing the wordmark"
              ></video>
            </div>
            <div class="card__body">
              <p class="card__index">Motion · 01</p>
              <h3>Startup splash</h3>
              <p class="card__text">
                Four seconds, ending on the horizontal lockup. Use it for launch
