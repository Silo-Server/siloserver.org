<script>
  // CSS can gate the GIF but not video autoplay, so hand the splash back to the
  // reader when they've asked for less motion.
  const splash = document.querySelector<HTMLVideoElement>(".motion-card video");
  if (splash && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    splash.autoplay = false;
    splash.loop = false;
    splash.controls = true;
    splash.pause();
  }
</script>

