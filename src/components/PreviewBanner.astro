---
// Shown only on pull request preview deployments. See src/data/preview.ts.
import { PREVIEW } from "../data/preview";
---

{
  PREVIEW && (
    <div class="preview-banner" role="status">
      <strong>Preview</strong> of{" "}
      <a href={PREVIEW.prUrl}>pull request #{PREVIEW.prNumber}</a>
      {PREVIEW.sha && <> at <code>{PREVIEW.sha}</code></>}. Not the published
      site.
    </div>
  )
}
