---
// Pinned scroll scene. Four steps, driven by scroll progress:
// 1. TV on Breaking Bad's series page, phone on Home with it in Continue
//    Watching.
// 2. On the phone: tap Remote, pick the Living Room TV, then tap Breaking Bad.
//    The episode starts on the TV and the remote opens (iOS control mode:
//    SiloControlModeButton → SiloControlTargetPickerView → launchOnEngagedTV).
// 3. The TV plays; the phone steps back, still a remote.
// 4. The TV turns off and the phone turns to landscape with the same episode.
import { Image } from "astro:assets";
import Canvas from "../mock/Canvas.astro";
import IPhone from "../mock/IPhone.astro";
import TvSeries from "../mock/TvSeries.astro";
import IosHome from "../mock/IosHome.astro";
import IosRemote from "../mock/IosRemote.astro";
import IosPlayer from "../mock/IosPlayer.astro";
import IosPicker from "../mock/IosPicker.astro";
import RoomScene from "./RoomScene.astro";
import { backdrop, seriesPages } from "../../data/home";

interface Props {
  scene?: boolean;
}
const { scene = false } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const steps = [
  {
    title: "Pick up where you left off.",
    body: "Your place is saved on your server, so every screen knows where you stopped.",
  },
  {
    title: "Or start it from your phone.",
    body: "Your TV remote works as always. You can also pick a TV in the Silo app and tap an episode to play it there.",
  },
  {
    title: "Enjoy the big screen.",
    body: "The episode plays on the TV, right where you were. Pause or skip from either remote.",
  },
  {
    title: "Keep watching on the go.",
    body: "Turn off the TV and carry on from your phone, right where you left off.",
  },
];
---

<section class:list={["experience", scene && "experience--scene"]} id="experience" aria-labelledby="experience-title">
  <div class="experience__track" data-scene data-progress data-progress-mode="pin">
    <div class="experience__pin">
      <div class="container experience__head">
        <h2 id="experience-title" class="h2 reveal-lines">
          <span class="ln"><span>From the big screen</span></span>
          <span class="ln"><span>to the palm of your hand.</span></span>
        </h2>
      </div>

      <div class="experience__stage">
        <div class="tvset scene-anchor" data-tvset>
          {scene && <RoomScene kind="evening" />}
          <div class:list={["screen screen--tv", !scene && "screen--bare"]}>
            <Canvas w={1920} h={1080} label="Breaking Bad's series page on Apple TV, then the episode playing.">
              <TvSeries show={seriesPages["breaking-bad"]} />
              <div class="tv-playing" data-tv-playing>
                <Image src={backdrop("breaking-bad")} alt="" widths={[900, 1600]} sizes="(min-width: 1200px) 1000px, 90vw" />
              </div>
            </Canvas>
          </div>
        </div>
        <IPhone label="Silo on iPhone: choosing the Living Room TV, starting Breaking Bad on it, then the episode playing on the phone." class="experience__phone">
          <IosHome />
          <IosPicker />
          <IosRemote />
          <IosPlayer />
          <span class="ios-tap" data-tap></span>
        </IPhone>
      </div>

      <ol class="container experience__steps">
        {
          steps.map((s, i) => (
            <li class:list={["experience__step", i === 0 && "is-on"]} data-step={i}>
              <span class="experience__bar"><span></span></span>
              <h3><button type="button" class="experience__goto" data-goto={i}>{s.title}</button></h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="container experience__notes">
    <div>
      <h3>Sign in a TV from your phone.</h3>
      <p>Check that the code on the TV matches, then approve it. No typing with a remote.</p>
    </div>
    <div>
      <h3>An app for every screen.</h3>
      <p>Apple TV, iPhone, iPad, Android, Android TV, and the web. Many Jellyfin apps, including Infuse, work too.</p>
    </div>
    <a class="link-arrow" href={`${baseUrl}/download`}>Get the apps <span aria-hidden="true">→</span></a>
  </div>
</section>
