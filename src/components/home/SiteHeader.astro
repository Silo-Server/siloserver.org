---
import { SITE } from "../../data/siteConfig";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (p: string) => `${baseUrl}${p}`;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href={href("/")} aria-label="Silo home">
      <img src={href("/brand/silo-wordmark-white.svg")} alt="Silo" width="1389" height="720" />
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <a href={href("/docs")}>Docs</a>
      <a href={SITE.github.orgUrl}>GitHub</a>
    </nav>
    <a class="btn btn--primary btn--sm site-header__cta" href={href("/download")}>
      Get Silo <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</header>

<script>
  // Only one Get Silo at a time: the header's button steps aside while the
  // page's own (marked data-get-silo) is on screen. Without JS it stays.
  const header = document.querySelector<HTMLElement>("[data-header]");
  const pageButtons = document.querySelectorAll<HTMLElement>("[data-get-silo]");
  if (header && pageButtons.length) {
    const inView = new Set<Element>();
    const update = () => header.classList.toggle("is-cta-hidden", inView.size > 0);
    // Check once up front, so a button visible on load never flashes in the
    // header first.
    pageButtons.forEach((b) => {
      const r = b.getBoundingClientRect();
      if (r.bottom > 0 && r.top < innerHeight) inView.add(b);
    });
    update();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) inView.add(e.target);
        else inView.delete(e.target);
      }
      update();
    });
    pageButtons.forEach((b) => io.observe(b));
  }
</script>
