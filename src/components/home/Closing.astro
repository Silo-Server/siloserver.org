---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="closing" aria-labelledby="closing-title" data-progress data-progress-range="1">
  <div class="closing__bars" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container closing__inner">
    <h2 id="closing-title" class="closing__title reveal-lines"><span class="ln"><span>Tonight, make it yours.</span></span></h2>
    <a class="btn btn--primary btn--lg rise" href={`${baseUrl}/download`}><span>
      Get Silo <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </span></a>
  </div>
</section>
