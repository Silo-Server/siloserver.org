---
// iPhone "Remote Control" TV picker, opened from the Remote button in Home's
// top bar. SiloControlTargetPickerView.swift: a medium-detent sheet with an
// inline "Remote Control" title and Done; one list row per Silo TV found,
// with a 38pt tv glyph on a resting-fill circle, the TV's name (headline) and
// its server (subheadline, secondary text); a spinner on the row while it
// connects. Picking a TV turns on control mode, so plays go to that TV.
import { nowPlaying } from "../../data/home";

const tvs = [nowPlaying.tv, "Bedroom"];
---

<div class="ios-picker" data-picker>
  <div class="ios-picker__bar">
    <span class="ios-picker__done">Done</span>
    <span class="ios-picker__title">Remote Control</span>
  </div>
  <div class="ios-picker__list">
    {
      tvs.map((name, i) => (
        <div class="ios-picker__row" data-picker-row={i === 0 ? "" : undefined}>
          <span class="ios-picker__icon">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="13" rx="2"></rect><path d="M8 20.5h8"></path></svg>
          </span>
          <span class="ios-picker__text">
            <b>{name}</b>
            <small>Home Server</small>
          </span>
          {i === 0 && <span class="ios-picker__spinner" />}
        </div>
      ))
    }
  </div>
</div>
