---
// iPhone remote sheet, controlling Breaking Bad on an Apple TV.
// SiloControlRemoteView: blurred backdrop at 45% under a 55% black wash;
// poster (max 300pt high, 16pt corners); episode title with
// "series · S1 · E1" below; "Playing on" pill; slider tinted #EDEDED with
// elapsed and "-remaining"; 10s back, 64pt play/pause, 30s forward, and next
// episode; volume; option chips.
import { Image } from "astro:assets";
import { backdrop, poster, nowPlaying, clock } from "../../data/home";
---

<div class="ios-remote" data-remote>
  <div class="ios-remote__bg">
    <Image src={backdrop(nowPlaying.slug)} alt="" width={720} />
  </div>
  <div class="ios-remote__bar">
    <span class="ios-glass ios-glass--icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
    </span>
    <span class="ios-glass ios-glass--icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><circle cx="5.5" cy="12" r="1.8"></circle><circle cx="12" cy="12" r="1.8"></circle><circle cx="18.5" cy="12" r="1.8"></circle></svg>
    </span>
  </div>
  <div class="ios-remote__body">
    <div class="ios-remote__art">
      <Image src={poster(nowPlaying.slug)} alt="" width={600} />
    </div>
    <div class="ios-remote__title">{nowPlaying.title}</div>
    <div class="ios-remote__subtitle">{nowPlaying.subtitle}</div>
    <div class="ios-remote__pill">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="8" y="2.5" width="8" height="19" rx="3"></rect><circle cx="12" cy="7" r="1.4" fill="currentColor"></circle></svg>
      Playing on {nowPlaying.tv}
    </div>
    <div class="ios-remote__scrub">
      <div class="ios-slider" style={`--p:${nowPlaying.progress}`} data-scrub data-start={nowPlaying.elapsed} data-total={nowPlaying.duration}><span></span><i></i></div>
      <div class="ios-remote__times"><span data-elapsed>{clock(nowPlaying.elapsed)}</span><span data-remaining>-{clock(nowPlaying.duration - nowPlaying.elapsed)}</span></div>
    </div>
    <div class="ios-remote__transport">
      <svg viewBox="0 0 30 30" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 6.5A11 11 0 1 1 4 15"></path><path d="M9 2v5H4"></path><text x="15" y="19.3" text-anchor="middle" font-size="9" font-weight="700" fill="currentColor" stroke="none" font-family="system-ui">10</text></svg>
      <span class="ios-remote__pp" data-playpause>
        <svg class="pp-pause" viewBox="0 0 24 24" width="28" height="28" fill="#000"><rect x="6" y="4.5" width="4" height="15" rx="1.2"></rect><rect x="14" y="4.5" width="4" height="15" rx="1.2"></rect></svg>
        <svg class="pp-play" viewBox="0 0 24 24" width="28" height="28" fill="#000"><path d="M7 4.5v15c0 .8.9 1.3 1.6.8l11.3-7.5a1 1 0 0 0 0-1.6L8.6 3.7C7.9 3.2 7 3.7 7 4.5Z"></path></svg>
      </span>
      <svg viewBox="0 0 30 30" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 6.5A11 11 0 1 0 26 15"></path><path d="M21 2v5h5"></path><text x="15" y="19.3" text-anchor="middle" font-size="9" font-weight="700" fill="currentColor" stroke="none" font-family="system-ui">30</text></svg>
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M4 5.6v12.8c0 .6.7 1 1.2.7l9.2-6.4a.8.8 0 0 0 0-1.4L5.2 4.9c-.5-.3-1.2.1-1.2.7Z"></path><rect x="16.5" y="5" width="2.6" height="14" rx="1"></rect></svg>
    </div>
    <div class="ios-remote__volume">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M4 9.5v5h3.5L12 19V5L7.5 9.5H4Z"></path></svg>
      <div class="ios-slider ios-slider--thin" style="--p:0.62"><span></span><i></i></div>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" opacity=".55"><path d="M3 9.5v5h3.5L11 19V5L6.5 9.5H3Z"></path><path d="M14 9a4 4 0 0 1 0 6M16.5 6.5a7.5 7.5 0 0 1 0 11M19 4a11 11 0 0 1 0 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    </div>
    <div class="ios-remote__chips">
      <span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>Quality</span>
      <span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 12h1M6.5 8v8M10 5v14M13.5 9v6M17 7v10M20.5 11v2"></path></svg>Audio</span>
      <span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4.5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-4.5 3.5v-3.5H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z"></path><path d="M7 9.5h4M13 9.5h4M7 12.5h6" stroke-linecap="round"></path></svg>Subtitles</span>
      <span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4.5 17a8.5 8.5 0 1 1 15 0"></path><path d="m12 13 3.5-4"></path><circle cx="12" cy="13.5" r="1.3" fill="currentColor"></circle></svg>Speed</span>
    </div>
  </div>
</div>
