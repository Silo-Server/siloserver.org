---
// Faux terminal demo shown in the hero — purely visual, no live data.
// Keep the output shaped like the real thing: the default compose project
// is called `silo`, and the liveness probe lives at /api/v1/health.
---

<div
  class="terminal"
  role="img"
  aria-label="Terminal showing docker compose up, a health check, and the web app opening"
>
  <div class="terminal__chrome">
    <span class="terminal__lights" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span class="terminal__title">silo@home:~/silo</span>
    <span class="terminal__tabs">
      <span class="terminal__tab terminal__tab--active">compose</span>
      <span class="terminal__tab">logs</span>
      <span class="terminal__tab">psql</span>
    </span>
  </div>
  <pre class="terminal__body" aria-hidden="true"><span class="t-mute">$</span> <span class="t-cmd">docker compose up -d</span>
<span class="t-mute">[+] Running 4/4</span>
 <span class="t-ok">✓</span> Network silo_default       Created   <span class="t-mute">0.1s</span>
 <span class="t-ok">✓</span> Container silo-postgres-1  Healthy   <span class="t-mute">6.2s</span>
 <span class="t-ok">✓</span> Container silo-redis-1     Healthy   <span class="t-mute">5.8s</span>
 <span class="t-ok">✓</span> Container silo-1           Started   <span class="t-mute">6.4s</span>

<span class="t-mute">$</span> <span class="t-cmd">curl -s localhost:8090/api/v1/health | jq</span>
&lbrace;
  <span class="t-key">"status"</span>: <span class="t-str">"ok"</span>,
  <span class="t-key">"server_name"</span>: <span class="t-str">"Silo"</span>,
  <span class="t-key">"server_id"</span>: <span class="t-str">"c1a7…f2e9"</span>
&rbrace;

<span class="t-mute">$</span> <span class="t-cmd">open http<wbr/>://localhost:8090</span><span class="t-cursor">█</span></pre>
</div>
