---
import SiloBars from "./SiloBars.astro";
import { SITE } from "../data/siteConfig";
---

<section class="section section--cta">
  <div class="container container--narrow">
    <div class="cta" data-reveal>
      <SiloBars size="lg" />
      <h2 class="cta__title">
        Run it. Read it. <br />Tell us what's broken.
      </h2>
      <p class="cta__sub">
        A self-hosted media server, built in the open. The best feedback
        you can send is a commit hash, a stack trace, and an opinion. The
        Discord is where the maintainers actually are: ask questions, report
        what broke, and see what is shipping next.
      </p>
      <div class="cta__actions">
        <a href={SITE.discord} class="btn btn--primary btn--discord">
          join the Discord <span class="btn__arrow">↗</span>
        </a>
        <a href={SITE.github.orgUrl} class="btn btn--ghost">
          github.com/Silo-Server <span class="btn__arrow">↗</span>
        </a>
        <a href={SITE.github.readmeUrl} class="btn btn--ghost">
          read the README <span class="btn__arrow">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
