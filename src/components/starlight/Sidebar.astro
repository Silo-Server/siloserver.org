---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<!-- The native persistence indexes now count subgroups only. Discard the old
     collapsible-root layout's indexes once, before Starlight restores them. -->
<script is:inline aria-hidden="true">
  try {
    if (sessionStorage.getItem('silo-sidebar-layout') !== 'fixed-roots-v1') {
      sessionStorage.removeItem('sl-sidebar-state');
      sessionStorage.setItem('silo-sidebar-layout', 'fixed-roots-v1');
    }
  } catch {}
</script>

<SidebarPersister>
  {sidebar.map((entry, index) => entry.type === 'group' ? (
    <section class="sidebar-category" aria-labelledby={`sidebar-category-${index}`}>
      <h2 class="large" id={`sidebar-category-${index}`}>{entry.label}</h2>
      <SidebarSublist sublist={entry.entries} nested />
    </section>
  ) : <SidebarSublist sublist={[entry]} />)}
</SidebarPersister>

<div class="md:sl-hidden"><MobileMenuFooter /></div>

<style>
  .sidebar-category + .sidebar-category { margin-top: 1.25rem; }
  h2 { margin: 0 0 0.4rem; padding: 0.2em 0.5rem; color: var(--sl-color-white); }
</style>
