---
// Replaces Starlight's site title with the Silo wordmark plus "Docs".
// The configured title still names the site in page <title> tags.

// The documentation lives below /docs, not at the marketing site's root.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/docs`;
---

<a href={href} class="site-title sl-flex">
  <img
    class="dark:sl-hidden"
    src={`${base}/brand/silo-wordmark-dark.svg`}
    alt="Silo"
    width="1389"
    height="720"
  />
  <img
    class="light:sl-hidden"
    src={`${base}/brand/silo-wordmark-white.svg`}
    alt="Silo"
    width="1389"
    height="720"
  />
  <span translate="no">Docs</span>
</a>

<style>
  .site-title {
    --logo-height: 1.75rem;
    --docs-size: 1rem;
    align-items: baseline;
    gap: 0.325rem;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  img {
    height: var(--logo-height);
    width: auto;
  }
  /* Set in the wordmark's typeface (Plus Jakarta Sans ExtraBold), with caps
     slightly shorter than the wordmark's. Baseline alignment puts the text on
     the image's bottom edge; the wordmark's letters sit 110 of 720 units above
     that, so raise the text by the same amount to share their baseline.

     ExtraBold is the heaviest weight, and at a smaller size its strokes are
     thinner than the wordmark's. The wordmark's letters are set at 0.88 of the
     artwork height and its strokes are 0.15 em, so outline the text by the
     difference to match stroke thickness, and space the letters by the same
     amount so the outline doesn't close the gaps. */
  span {
    --stroke: calc(0.15 * (var(--logo-height) * 0.88 - var(--docs-size)));
    position: relative;
    bottom: calc(var(--logo-height) * 110 / 720);
    font-family: "Plus Jakarta Sans", var(--sl-font);
    font-size: var(--docs-size);
    font-weight: 800;
    letter-spacing: var(--stroke);
    line-height: 1;
    text-transform: uppercase;
    -webkit-text-stroke: var(--stroke) currentColor;
  }
</style>
