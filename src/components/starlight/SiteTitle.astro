---
// Replaces Starlight's site title with the Silo wordmark plus "Docs".
// The configured title still names the site in page <title> tags.

// The documentation lives below /docs, not at the marketing site's root.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/docs`;
---

<a href={href} class="site-title sl-flex">
  <img
    class="dark:sl-hidden"
    src={`${base}/brand/silo-wordmark-dark.svg`}
    alt="Silo"
    width="1389"
    height="720"
  />
  <img
    class="light:sl-hidden"
    src={`${base}/brand/silo-wordmark-white.svg`}
    alt="Silo"
    width="1389"
    height="720"
  />
  <span translate="no">Docs</span>
</a>

<style>
  .site-title {
    --logo-height: 1.75rem;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  img {
    height: var(--logo-height);
    width: auto;
  }
  /* Set in the wordmark's typeface (Plus Jakarta Sans ExtraBold), with caps
     slightly shorter than the wordmark's. Baseline alignment puts the text on
     the image's bottom edge; the wordmark's letters sit 110 of 720 units above
     that, so raise the text by the same amount to share their baseline. */
  span {
    position: relative;
    bottom: calc(var(--logo-height) * 110 / 720);
    font-family: "Plus Jakarta Sans", var(--sl-font);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
  }
</style>
