---
interface Props {
  class?: string;
}

const { class: extra = "" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<span class={`brand-lockup ${extra}`} role="img" aria-label="Silo">
  <img
    class="brand-lockup__on-light"
    src={`${baseUrl}/brand/silo-wordmark-dark.svg`}
    alt=""
    aria-hidden="true"
    width="1389"
    height="720"
  />
  <img
    class="brand-lockup__on-dark"
    src={`${baseUrl}/brand/silo-wordmark-white.svg`}
    alt=""
    aria-hidden="true"
    width="1389"
    height="720"
  />
</span>
