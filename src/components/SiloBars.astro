---
// A decorative three-bar motif drawn from Silo's color palette. This is not
// the Silo logo; identity lockups use BrandLockup instead.

interface Props {
  size?: "xs" | "sm" | "md" | "lg" | "row";
  class?: string;
}

const { size = "md", class: extra = "" } = Astro.props;
const modifier = size === "md" ? "" : ` silo-bars--${size}`;
---

<span class={`silo-bars${modifier} ${extra}`} aria-hidden="true">
  <i></i><i></i><i></i>
</span>
