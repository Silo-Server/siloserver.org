---
// Shell for legal and policy pages (/privacy, /account-deletion). App store
// listings link to these URLs, so they must stay stable and public.
import MarketingPage from "../layouts/MarketingPage.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  meta?: string;
}

const { title, description, eyebrow, heading, meta } = Astro.props;
---

<MarketingPage title={title} description={description}>
  <div class="container">
    <header class="page-head policy-head">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="page-title policy-title">{heading}</h1>
      {meta && <p class="policy-meta">{meta}</p>}
    </header>
    <article class="prose">
      <slot />
    </article>
  </div>
</MarketingPage>

<style is:global>
  .policy-title {
    font-size: clamp(36px, 4.6vw, 60px);
    max-width: 18em;
  }
  .policy-meta {
    margin: 18px 0 0;
    color: var(--fg-mute);
    font-size: 14px;
  }
  .policy-head {
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .prose .policy__lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--fg);
  }
</style>
